# Copy to .env (never commit .env). Every variable GigBid reads, no real values.
APP_ENV=development
APP_SECRET_KEY=replace_me_long_random
MCP_JWT_SECRET=replace_me_long_random
TOKEN_ENCRYPTION_KEY=replace_me_fernet_key
COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
ALLOW_SIGNUP=1

# Database / queue / vectors (compose sets these automatically)
DATABASE_URL=
MCP_DATABASE_URL=
POSTGRES_PASSWORD=gigbid
REDIS_URL=
QDRANT_URL=
VECTOR_STORE=numpy
WORKER_MODE=
INLINE_CONCURRENCY=2

# Marketplace
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=gigsim-dev-token
GIGSIM_ADMIN_TOKEN=replace_me
GIGSIM_AUTO_TICK_SECONDS=60
GIGSIM_ERROR_RATE=0.02
GIGSIM_POLICY_VERSION=2026-10
UPWORK_REDIRECT_URI=http://localhost:8000/api/accounts/upwork/callback

# MCP servers (HTTP mode); GIGBID_MCP_INPROCESS=1 runs them inside the API process instead
GIGBID_MCP_INPROCESS=1
MCP_PORTFOLIO_URL=http://localhost:8101/mcp
MCP_MARKETPLACE_URL=http://localhost:8102/mcp
MCP_WORKSPACE_URL=http://localhost:8103/mcp
GITHUB_PAT=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Models (agent/config.yaml profiles: open | open_local | open_small | paid | test)
MODEL_PROFILE=open
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
NODE_TIMEOUT_S=120
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_VARIANT=v8_corrective
PROPOSAL_STRATEGY=evidence_first

# Tracing (LangSmith); masking is applied to every input/output
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
LANGSMITH_PROJECT_URL=

# Reviewer account (seeded on start); put the real values ONLY in the private Classroom comment
REVIEWER_EMAIL=reviewer@gigbid.app
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml_engineer
SEED_ON_START=1
